{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-read-path.sh"
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-read-path.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-db-access.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-agent-role.sh"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-read-path.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-db-access.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-agent-role.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/check-branch.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-db-access.sh"
          },
          {
            "type": "command",
            "command": "bash .claude/hooks/check-agent-role.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/auto-open-pr.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git pull*)",
      "Bash(git fetch*)",
      "Bash(gh*)",
      "Bash(mvn*)",
      "Bash(./mvnw*)",
      "Bash(npm*)",
      "Bash(npx*)",
      "Bash(ls*)",
      "Bash(cat*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f *)"
    ]
  }
}
